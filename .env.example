# Copy to .env and fill in. Never commit .env.

# development | testing | production
# Production refuses to boot without SESSION_SECRET, DATABASE_URL, and Stripe keys.
APP_ENV=development

# Required in production. Any long random string.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Local default is SQLite at instance/app.db when this is empty.
# Production example (Render/Railway/Neon/Fly Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/foodtruckfundraiser
DATABASE_URL=

# Stripe. Test mode is the default and will refuse live keys.
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Only when you intentionally accept real cards:
# STRIPE_TEST_MODE=false
# STRIPE_SECRET_KEY=sk_live_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# Optional alternate names, used only when STRIPE_TEST_MODE=false:
# STRIPE_SECRET_KEY_LIVE=
# STRIPE_PUBLISHABLE_KEY_LIVE=

# Created on first boot if both are set. There is no built-in password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password

# Sample Green Truck, organizer, and one future event. Ignored when APP_ENV=production.
SEED_DEMO_DATA=false
DEMO_OWNER_EMAIL=owner@example.com
DEMO_OWNER_PASSWORD=replace-me
DEMO_ORGANIZER_EMAIL=organizer@example.com
DEMO_ORGANIZER_PASSWORD=replace-me

# Optional. Leave RESTORE_EVENT_BACKUP false unless you mean to load data_backups/.
# Those files are a September 2025 snapshot of two real events, not a full database.
RESTORE_EVENT_BACKUP=false

# Email. Leave blank locally; messages are skipped until both username and password are set.
# MAIL_SERVER examples: smtp.sendgrid.net, smtp.gmail.com, email-smtp.us-east-1.amazonaws.com
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=support@foodtruckfundraiser.com
# Older names still accepted: EMAIL_USERNAME, EMAIL_PASSWORD, EMAIL_PASSWORD_NEW
MAIL_SUPPRESS_SEND=false

# AI support chat. The rest of the app runs without it.
OPENAI_API_KEY=

# PayPal payouts from the admin payout screens. Optional.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Set true only if the app is embedded in Squarespace / thefoodtruckstop.com.
# That forces Secure cookies and SameSite=None, which browsers reject on http://localhost.
IFRAME_EMBED=false
SESSION_COOKIE_SECURE=false

# Used by `python main.py`. Render/Fly set PORT for you. Gunicorn reads it via the Procfile.
PORT=5000
FLASK_DEBUG=false
